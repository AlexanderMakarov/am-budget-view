# Login into https://account.myameria.am and open cards and accounts pages.
# Next see URL in browser and open developer tools too see response headers.
# Some headers values would be needed to fill in this file.
my_ameria:
  # "Client-Id" request header value.
  client_id: "e1cca45d-f2e6-463e-fe84-97f0c1c51315"
  # "Authorization" token request header value, starts with "Bearer " and expires in ~10 minutes.
  auth_token: "Bearer <long_token>"
  # Start day to get statement. Always until today.
  since-DD-MM-YYYY: "01-09-2024"
  # How to name a resulting file. Should be matched by 'genericCsvFilesGlob' in config.yaml.
  history_path: "../generic MyAmeria History since 2024-09-01.csv"

# AmeriaBank (online.ameriabank.am) for legal entities.
# After QR login, copy from DevTools → Network: Cookie and Content.MainForm.wgx request URL.
# Script simulates opening each account and downloading CSV (since date → today).
ameriabank:
  content_url: ""
  cookie: ""
  # Start date for statements (same format as my_ameria). End date is always today.
  since-DD-MM-YYYY: "01-09-2024"
  # Base folder for CSV files (relative to scripts/ or absolute). If empty, scripts folder.
  folder_path: ""
  # If empty or omitted: download all accounts with names "<account_number>_<account_name>_since_<since>.csv".
  # If set: download only listed accounts; each can override path (relative to scripts/ or absolute).
  # accounts:
  #   - name: "USD account"
  #     number: "1570031053801234"
  #     path: "../157003105301234 USD account since 2024-04-01.csv"
