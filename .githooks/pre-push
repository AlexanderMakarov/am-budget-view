#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
check=0
while read -r local_ref local_sha remote_ref remote_sha; do
    case "$local_sha" in 0000000000000000000000000000000000000000) continue ;; esac
    if [ "$(git rev-parse "$local_sha^{commit}")" != "$(git rev-parse HEAD)" ]; then
        echo 'Check out the commit being pushed so local checks validate that commit.' >&2
        exit 1
    fi
    check=1
done
[ "$check" = 1 ] || exit 0
if ! git diff --quiet HEAD; then
    echo 'Commit or stash tracked changes before pushing so checks match the pushed commit.' >&2
    exit 1
fi
exec make check
